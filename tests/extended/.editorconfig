# Inherits the main tests' configuration, only relaxing the rules that the extended applications need

[*]

# Microsoft.CodeAnalysis.NetAnalyzers
# CA1873: Avoid potentially expensive logging (the testbench, workloads and benchmarks log freely)
dotnet_diagnostic.CA1873.severity = none

# Microsoft.VisualStudio.Threading.Analyzers
# VSTHRD001: Avoid legacy thread switching APIs (the WPF testbench uses the dispatcher, without a JoinableTaskFactory)
dotnet_diagnostic.VSTHRD001.severity = none
