<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <NoWarn>$(NoWarn);NU1507</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.401"/>
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23"/>
    <PackageVersion Include="Silverback.Integration.Kafka" Version="$(BaseVersion)"/>
    <PackageVersion Include="Silverback.Integration.Kafka.SchemaRegistry" Version="$(BaseVersion)"/>
    <PackageVersion Include="Silverback.Integration.Mqtt" Version="$(BaseVersion)"/>
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556"/>
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3"/>
  </ItemGroup>
</Project>
